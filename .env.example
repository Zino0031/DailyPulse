# Copy to .env (never commit .env) and fill in from your Supabase
# project dashboard: Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Dev only: skip the auth gate to preview protected screens before Epic 1.
# Keep commented out (or absent) for normal behavior.
# EXPO_PUBLIC_BYPASS_AUTH=true

# Dev switch for outfit generation. `false` composes on-device instead of
# calling `generate-outfit`; the daily generation/Regenerate allowance still
# applies (it is spent server-side either way). Unset/`true` = AI stylist.
# EXPO_PUBLIC_AI_GENERATION=false

# RevenueCat public SDK keys (issue #17) — RevenueCat dashboard -> Project
# settings -> API keys. Public keys are safe in the app; the secret key goes
# in Supabase function secrets only (see supabase/README.md).
# Test Store key (test_…): simulated purchases on every platform, including
# Expo Go and web — nothing is ever charged. Takes priority when set.
# EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_xxxxxxxx
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxx
# EXPO_PUBLIC_REVENUECAT_WEB_KEY=rcb_xxxxxxxx
# Unset = purchases unavailable; the paywall says so and limits still apply.
