{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  // Edge functions run on Deno and deploy via `supabase functions deploy`
  // (see supabase/README.md) — the app compiler must skip them.
  "exclude": ["supabase/functions/**/*", "node_modules"]
}
